# ---------------------------------------------------------------------------
# Supabase — required from Phase 1
# Project Settings → API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — never expose to the browser.
# Required from Phase 4 (storage + admin operations).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OpenAI — required from Phase 5 (image generation)
# Server-only.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional. Defaults to gpt-image-2 (current recommended image model).
# Override here rather than editing code when OpenAI ships a newer model.
OPENAI_IMAGE_MODEL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute base URL, used for auth redirect callbacks.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
